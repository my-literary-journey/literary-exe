
document.addEventListener("DOMContentLoaded", function () {

  // ==================================
  // 1. BOOK COLLECTION
  // ==================================

  const bookButtons = document.querySelectorAll(".book");
  const readingView = document.getElementById("readingView");

  function displayBook(index) {

    if (!window.BOOKS || !window.BOOKS[index]) {
      if (readingView) {
        readingView.innerHTML =
          "<p>Book content is not available yet.</p>";
      }
      return;
    }

    const book = window.BOOKS[index];

    bookButtons.forEach(function (button) {
      button.classList.remove("active");
    });

    if (bookButtons[index]) {
      bookButtons[index].classList.add("active");
    }

    if (readingView) {
      readingView.innerHTML = `
        <p class="eyebrow">LITERARY ANALYSIS</p>
        <h3>${book.title}</h3>

        ${book.image ? `
          <img
            class="feature-image"
            src="${book.image}"
            alt="${book.title}"
          >
        ` : ""}

        <div class="book-content">
          ${book.content.map(function (paragraph) {
            return `<p>${paragraph}</p>`;
          }).join("")}
        </div>
      `;

      readingView.classList.remove("hidden");

      readingView.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });
    }
  }

  bookButtons.forEach(function (button, index) {
    button.addEventListener("click", function () {
      displayBook(index);
    });
  });


  // ==================================
  // 2. LEARNING AND REFLECTION
  // ==================================

  const learningContent =
    document.getElementById("learningContent");

  const reflectionContent =
    document.getElementById("reflectionContent");

  if (window.LEARNING && learningContent) {
    learningContent.innerHTML =
      `<p>${window.LEARNING}</p>`;
  }

  if (window.REFLECTION && reflectionContent) {
    reflectionContent.innerHTML =
      `<p>${window.REFLECTION}</p>`;
  }


  // ==================================
  // 3. BACKGROUND MUSIC
  // ==================================

  const music = document.getElementById("backgroundMusic");
  const musicToggle = document.getElementById("musicToggle");

  if (music && musicToggle) {

    music.volume = 0.35;

    function updateMusicButton() {
      if (music.paused) {
        musicToggle.innerHTML = "♫ Sound Off";
        musicToggle.setAttribute("aria-label", "Play background music");
      } else {
        musicToggle.innerHTML = "♫ Sound On";
        musicToggle.setAttribute("aria-label", "Stop background music");
      }
    }

    // Attempt automatic playback
    music.play()
      .then(function () {
        updateMusicButton();
      })
      .catch(function () {
        updateMusicButton();
      });

    // Play or pause when clicked
    musicToggle.addEventListener("click", function () {

      if (music.paused) {
        music.play().then(function () {
          updateMusicButton();
        }).catch(function () {
          updateMusicButton();
        });
      } else {
        music.pause();
        updateMusicButton();
      }

    });

    updateMusicButton();
  }

});
